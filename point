    /**
     * 9. RENDER RECENT LOGS, SUMMARY KPIS & GLOBAL WARNING (> 200)
     */
    function buildStudentSummaries() {
      const map = new Map();
      students.forEach(s => {
        map.set(s.id, {
          ...s,
          casesCount: 0,
          totalPoints: 0,
          logs: []
        });
      });

      violationLogs.forEach(log => {
        if (!map.has(log.studentId)) {
          map.set(log.studentId, {
            id: log.studentId,
            nama: log.studentName,
            nis: log.studentNis || '-',
            nisn: log.studentNisn || '-',
            kelas: log.studentClass,
            casesCount: 0,
            totalPoints: 0,
            logs: []
          });
        }
        const entry = map.get(log.studentId);
        entry.casesCount += 1;
        entry.totalPoints += Number(log.points || 0);
        entry.logs.push(log);
      });

      return Array.from(map.values()).sort((a, b) => {
        if (b.totalPoints !== a.totalPoints) return b.totalPoints - a.totalPoints;
        if (b.casesCount !== a.casesCount) return b.casesCount - a.casesCount;
        return a.nama.localeCompare(b.nama);
      });
    }

