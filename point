    function renderTopStudentsChart(topStudents) {
      const canvas = document.getElementById('topStudentsChart');
      if (!canvas || typeof Chart === 'undefined') return;

      if (topChartInstance) {
        topChartInstance.destroy();
      }

      const labels = topStudents.length > 0
        ? topStudents.map(s => `${s.nama.length > 18 ? s.nama.slice(0, 18) + '…' : s.nama} (${s.kelas})`)
        : ['Belum Ada Pelanggaran'];
      const dataPoints = topStudents.length > 0 ? topStudents.map(s => s.totalPoints) : [0];
      const bgColors = topStudents.length > 0
        ? topStudents.map(s => s.totalPoints > 200 ? '#e11d48' : '#2563eb')
        : ['#cbd5e1'];

      topChartInstance = new Chart(canvas.getContext('2d'), {
        type: 'bar',
        data: {
          labels,
          datasets: [{
            label: 'Total Poin Pelanggaran',
            data: dataPoints,
            backgroundColor: bgColors,
            borderRadius: 8,
            maxBarThickness: 42
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              callbacks: {
                label: (ctx) => ` Total Skor: ${ctx.parsed.y} Poin${ctx.parsed.y > 200 ? ' (WARNING > 200)' : ''}`
              }
            }
          },
          scales: {
            y: {
              beginAtZero: true,
              grid: { color: '#f1f5f9' },
              ticks: { font: { size: 11 } }
            },
            x: {
              grid: { display: false },
              ticks: { font: { size: 10, weight: '600' } }
            }
          }
        }
      });
    }

