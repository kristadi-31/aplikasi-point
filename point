    /**
     * 8. ENTRY FORM: TANGGAL, HARI, KELAS, FILTER SISWA & POIN OTOMATIS
     */
    function initDateAndDay() {
      const dateInput = document.getElementById('inputTanggal');
      const today = new Date();
      const yyyy = today.getFullYear();
      const mm = String(today.getMonth() + 1).padStart(2, '0');
      const dd = String(today.getDate()).padStart(2, '0');
      dateInput.value = `${yyyy}-${mm}-${dd}`;
      syncDayFromDate();
    }

    function syncDayFromDate() {
      const dateVal = document.getElementById('inputTanggal').value;
      if (!dateVal) return;
      const parts = dateVal.split('-');
      const dt = new Date(Number(parts[0]), Number(parts[1]) - 1, Number(parts[2]));
      const dayNames = ['Minggu', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];
      document.getElementById('inputHari').value = dayNames[dt.getDay()];
    }

    function populateClassDropdowns() {
      const filteredClasses = selectedGradePrefix
        ? CLASSES.filter(c => c.startsWith(selectedGradePrefix))
        : CLASSES;

      const entryClassSel = document.getElementById('inputKelas');
      const currentEntryVal = entryClassSel.value;
      entryClassSel.innerHTML = `<option value="">-- ${selectedGradePrefix ? 'Semua Kelas ' + selectedGradePrefix : 'Semua Kelas'} --</option>`;
      filteredClasses.forEach(cls => {
        const opt = document.createElement('option');
        opt.value = cls;
        opt.textContent = `Kelas ${cls}`;
        entryClassSel.appendChild(opt);
      });
      if (filteredClasses.includes(currentEntryVal)) {
        entryClassSel.value = currentEntryVal;
      }

      // Other class dropdowns (only populate once or keep full list)
      ['recapClassFilter', 'directoryClassFilter', 'newStudentClass'].forEach(id => {
        const el = document.getElementById(id);
        if (!el) return;
        const prev = el.value;
        const firstOptText = id === 'newStudentClass' ? '-- Pilih Kelas --' : 'Semua Kelas';
        el.innerHTML = `<option value="">${firstOptText}</option>`;
        CLASSES.forEach(cls => {
          const opt = document.createElement('option');
          opt.value = cls;
          opt.textContent = id === 'newStudentClass' ? cls : `Kelas ${cls}`;
          el.appendChild(opt);
        });
        if (CLASSES.includes(prev)) el.value = prev;
      });
