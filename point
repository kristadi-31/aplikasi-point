    function handleLoginSubmit(e) {
      e.preventDefault();
      const selectedRole = document.getElementById('loginSelectedRole').value;
      const rawIdentifier = document.getElementById('loginUsername').value.trim().toLowerCase();
      const rawPassword = document.getElementById('loginPassword').value.trim();
      const errorBox = document.getElementById('loginErrorBox');
      const errorText = document.getElementById('loginErrorText');

      if (!rawIdentifier || !rawPassword) {
        errorText.textContent = 'Harap isi username/NIP dan kata sandi terlebih dahulu.';
        errorBox.classList.remove('hidden');
        return;
      }

      const matchedUser = appUsers.find(u => {
        const matchId = (u.username && u.username.toLowerCase() === rawIdentifier) ||
                        (u.nip && u.nip !== '-' && u.nip.toLowerCase() === rawIdentifier);
        return matchId && u.password === rawPassword;
      });

      if (!matchedUser) {
        errorText.textContent = 'Username / NIP atau kata sandi tidak cocok. Periksa kembali akun Anda.';
        errorBox.classList.remove('hidden');
        return;
      }

      if (matchedUser.role !== selectedRole) {
        errorText.textContent = `Akun "${matchedUser.fullName}" terdaftar sebagai ${matchedUser.role.toUpperCase()}. Silakan pilih tab Login ${matchedUser.role === 'admin' ? 'Admin' : 'Guru'}.`;
        errorBox.classList.remove('hidden');
        return;
      }

      errorBox.classList.add('hidden');
      completeLogin(matchedUser);
    }

