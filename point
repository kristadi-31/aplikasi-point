      const activePill = document.getElementById(activePillId);
      if (activePill) {
        activePill.className = 'grade-pill px-3 py-1.5 rounded-xl text-xs font-bold bg-blue-600 text-white shadow-xs transition cursor-pointer shrink-0';
      }

