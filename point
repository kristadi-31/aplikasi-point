    function clearSelectedStudent() {
      document.getElementById('selectedStudentId').value = '';
      document.getElementById('studentSearchInput').value = '';
      document.getElementById('selectedStudentCard').classList.add('hidden');
      document.getElementById('clearStudentSelectionBtn').classList.add('hidden');
    }

    function populateViolationDropdown(filterText = '') {
      const selectEl = document.getElementById('inputViolation');
      const prevVal = selectEl.value;
      const kw = filterText.trim().toLowerCase();

      const filteredRules = VIOLATION_RULES.filter(r =>
        !kw || r.text.toLowerCase().includes(kw) || String(r.id) === kw || String(r.points) === kw
      );

      selectEl.innerHTML = `<option value="">-- Pilih Jenis Pelanggaran (${filteredRules.length} aturan) --</option>`;
      filteredRules.forEach(rule => {
        const opt = document.createElement('option');
        opt.value = String(rule.id);
        opt.textContent = `${rule.id}. ${rule.text} (+${rule.points} Poin)`;
        selectEl.appendChild(opt);
      });

      if (filteredRules.some(r => String(r.id) === prevVal)) {
        selectEl.value = prevVal;
      }
      updateAutoPointDisplay();
    }

    function updateAutoPointDisplay() {
      const ruleId = Number(document.getElementById('inputViolation').value);
      const box = document.getElementById('autoPointBox');
      const display = document.getElementById('autoPointDisplay');
      const rule = VIOLATION_RULES.find(r => r.id === ruleId);

      if (!rule) {
        display.textContent = '0 Poin';
        display.className = 'text-xl font-extrabold font-display text-slate-700';
        box.className = 'h-[52px] px-4 rounded-xl border-2 border-slate-200 bg-slate-50 flex items-center justify-between transition-colors';
        return;
      }

      display.textContent = `+${rule.points} Poin`;
      if (rule.points >= 200) {
        display.className = 'text-xl font-extrabold font-display text-rose-700';
        box.className = 'h-[52px] px-4 rounded-xl border-2 border-rose-300 bg-rose-50 flex items-center justify-between transition-colors';
      } else if (rule.points >= 50) {
        display.className = 'text-xl font-extrabold font-display text-amber-700';
        box.className = 'h-[52px] px-4 rounded-xl border-2 border-amber-300 bg-amber-50 flex items-center justify-between transition-colors';
      } else {
        display.className = 'text-xl font-extrabold font-display text-blue-700';
        box.className = 'h-[52px] px-4 rounded-xl border-2 border-blue-300 bg-blue-50 flex items-center justify-between transition-colors';
      }
    }

    function handleViolationSubmit(e) {
      e.preventDefault();
      const tanggal = document.getElementById('inputTanggal').value;
      const hari = document.getElementById('inputHari').value;
      const studentId = document.getElementById('selectedStudentId').value;
      const ruleId = Number(document.getElementById('inputViolation').value);
      const notes = document.getElementById('inputNotes').value.trim();

      if (!tanggal || !hari) {
        showToast('Harap lengkapi tanggal dan hari pelanggaran.', 'error');
        return;
      }
      if (!studentId) {
        showToast('Silakan pilih nama siswa terlebih dahulu dari daftar.', 'error');
        document.getElementById('studentSearchInput').focus();
        return;
      }
      if (!ruleId) {
        showToast('Silakan pilih jenis pelanggaran.', 'error');
        document.getElementById('inputViolation').focus();
        return;
      }

      const student = students.find(s => s.id === studentId);
      const rule = VIOLATION_RULES.find(r => r.id === ruleId);
      if (!student || !rule) return;

      const newLog = {
        id: `log-${Date.now()}-${Math.random().toString(36).slice(2, 6)}`,
        tanggal,
        hari,
        studentId: student.id,
        studentName: student.nama,
        studentClass: student.kelas,
        studentNis: student.nis || '-',
        studentNisn: student.nisn || '-',
        ruleId: rule.id,
        violationText: rule.text,
        points: rule.points,
        notes: notes || '-',
        recordedBy: currentUser ? currentUser.fullName : 'Petugas',
        recordedRole: currentUser ? currentUser.role : 'guru',
        createdAt: new Date().toISOString()
      };

      violationLogs.unshift(newLog);
      saveLogs();

      const updatedTotal = getStudentTotalPoints(student.id);
      if (updatedTotal > 200) {
        showToast(`PERINGATAN! ${student.nama} (${student.kelas}) kini mencapai ${updatedTotal} Poin (> 200)!`, 'warning');
      } else {
        showToast(`Tersimpan: ${student.nama} (+${rule.points} Poin). Total: ${updatedTotal} Poin.`, 'success');
      }

      // Reset violation fields while keeping date/day convenient for next entry
      clearSelectedStudent();
      document.getElementById('violationFilterInput').value = '';
      populateViolationDropdown('');
      document.getElementById('inputNotes').value = '';

      refreshAllViews();
    }

    function resetEntryForm() {
      initDateAndDay();
      selectedGradePrefix = '';
      document.querySelectorAll('.grade-pill').forEach(btn => {
        btn.className = 'grade-pill px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-700 transition cursor-pointer shrink-0';
      });
      document.getElementById('grade-pill-all').className = 'grade-pill px-3 py-1.5 rounded-xl text-xs font-bold bg-blue-600 text-white shadow-xs transition cursor-pointer shrink-0';
      populateClassDropdowns();
      document.getElementById('inputKelas').value = '';
      clearSelectedStudent();
      document.getElementById('violationFilterInput').value = '';
      populateViolationDropdown('');
      document.getElementById('inputNotes').value = '';
    }

