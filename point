    function handleStudentFileUpload(e) {
      const file = e.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function (evt) {
        try {
          const data = new Uint8Array(evt.target.result);
          const workbook = XLSX.read(data, { type: 'array' });
          const firstSheet = workbook.Sheets[workbook.SheetNames[0]];
          const rows = XLSX.utils.sheet_to_json(firstSheet, { defval: '' });

          let addedCount = 0;
          let updatedCount = 0;

          rows.forEach((row, idx) => {
            const norm = {};
            Object.keys(row).forEach(k => {
              norm[k.trim().toLowerCase()] = String(row[k]).trim();
            });

            const nama = norm.nama || norm['nama siswa'] || norm['nama lengkap'] || '';
            const nis = norm.nis || '-';
            const nisn = norm.nisn || '-';
            let kelas = (norm.kelas || '').toUpperCase().replace(/^KELAS\s*/i, '').trim();

            if (!nama || !CLASSES.includes(kelas)) {
              return;
            }

            const existing = students.find(
              s => s.nama.toLowerCase() === nama.toLowerCase() && s.kelas === kelas
            );

            if (existing) {
              if (nis && nis !== '-') existing.nis = nis;
              if (nisn && nisn !== '-') existing.nisn = nisn;
              updatedCount++;
            } else {
              students.push({
                id: `stu-imp-${Date.now()}-${idx}`,
                nama,
                nis: nis || '-',
                nisn: nisn || '-',
                kelas
              });
              addedCount++;
            }
          });

          saveStudents();
          refreshAllViews();
          showToast(`Impor selesai: ${addedCount} siswa baru ditambahkan, ${updatedCount} data siswa diperbarui.`, 'success');
        } catch (err) {
          console.error(err);
          showToast('Gagal membaca file Excel/CSV. Pastikan format sesuai template.', 'error');
        } finally {
          e.target.value = '';
        }
      };
      reader.readAsArrayBuffer(file);
    }

