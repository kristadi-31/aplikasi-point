<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>POINT — Rekap Pelanggaran Siswa SMPN 1 SIDOMULYO</title>

  <!-- Google Fonts: Plus Jakarta Sans & Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            display: ['Plus Jakarta Sans', 'sans-serif'],
          },
          colors: {
            brand: {
              50: '#eff6ff',
              100: '#dbeafe',
              500: '#3b82f6',
              600: '#2563eb',
              700: '#1d4ed8',
              800: '#1e3a8a',
              900: '#0f172a',
            }
          }
        }
      }
    };
  </script>

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <!-- Chart.js for Violation Bar Chart -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <!-- SheetJS (XLSX) for Excel Import & Export -->
  <script src="https://cdn.sheetjs.com/xlsx-0.20.1/package/dist/xlsx.full.min.js"></script>

  <!-- jsPDF & AutoTable for PDF Export -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>

  <style>
    body {
      font-family: 'Inter', sans-serif;
      background-color: #f1f5f9;
      color: #0f172a;
    }
    h1, h2, h3, .font-display {
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
    /* Custom scrollbar for dropdown lists */
    .custom-scroll::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    .custom-scroll::-webkit-scrollbar-track {
      background: #f1f5f9;
      border-radius: 9999px;
    }
    .custom-scroll::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 9999px;
    }
    .custom-scroll::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
    @keyframes pulseBorder {
      0%, 100% { box-shadow: 0 0 0 0 rgba(225, 29, 72, 0.35); }
      50% { box-shadow: 0 0 0 6px rgba(225, 29, 72, 0); }
    }
    .warning-pulse {
      animation: pulseBorder 2s infinite;
    }

    /* ==================== DESKTOP & MOBILE VIEW MODE STYLES ==================== */
    body.view-mobile #appShell {
      padding-bottom: 5rem;
    }
    body.view-mobile #mainContentContainer {
      max-width: 34rem;
      padding-left: 0.875rem;
      padding-right: 0.875rem;
      padding-top: 1rem;
      padding-bottom: 1rem;
    }
    body.view-mobile #headerInnerContainer {
      max-width: 34rem;
      padding-left: 0.875rem;
      padding-right: 0.875rem;
      padding-top: 0.75rem;
      padding-bottom: 0.75rem;
    }
    body.view-mobile #desktopTopNav {
      display: none !important;
    }
    body.view-mobile #mobileBottomNav {
      display: flex !important;
    }
    body.view-mobile #view-entry {
      grid-template-columns: repeat(1, minmax(0, 1fr)) !important;
      gap: 1rem;
    }
    body.view-mobile #entryFormCard,
    body.view-mobile #entryRecentCard {
      grid-column: span 1 / span 1 !important;
    }
    body.view-mobile #violationForm {
      padding: 1rem;
      gap: 1rem;
    }
    body.view-mobile #violationForm input:not([type="hidden"]),
    body.view-mobile #violationForm select {
      min-height: 48px;
      font-size: 16px;
      border-radius: 0.875rem;
    }
    body.view-mobile #violationForm button[type="submit"] {
      min-height: 52px;
      font-size: 15px;
    }
    body.view-mobile #studentDropdownList button {
      padding-top: 0.75rem;
      padding-bottom: 0.75rem;
    }
    body.view-desktop #mobileBottomNav {
      display: none !important;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col antialiased selection:bg-blue-600 selection:text-white">

  <!-- ==================== LOGIN DASHBOARD SCREEN ==================== -->
  <div id="loginScreen" class="min-h-screen flex items-center justify-center bg-gradient-to-br from-slate-950 via-blue-950 to-slate-900 p-4 sm:p-6">
    <div class="max-w-5xl w-full grid grid-cols-1 lg:grid-cols-12 bg-white rounded-3xl shadow-2xl overflow-hidden border border-white/10">
      
      <!-- Left Branding & Info Panel -->
      <div class="lg:col-span-5 bg-gradient-to-br from-blue-900 via-indigo-900 to-slate-900 text-white p-7 sm:p-10 flex flex-col justify-between relative overflow-hidden">
        <div class="relative z-10">
          <div class="inline-flex items-center gap-3 px-3.5 py-2 rounded-2xl bg-white/10 border border-white/15 backdrop-blur-xs mb-6">
            <div class="w-9 h-9 rounded-xl bg-blue-500 flex items-center justify-center shadow-md">
              <i data-lucide="shield-alert" class="w-5 h-5 text-white"></i>
            </div>
            <div>
              <span class="font-display font-extrabold text-lg tracking-tight block leading-none">POINT</span>
              <span class="text-[11px] text-blue-200 font-medium">Tata Tertib 2026</span>
            </div>
          </div>

          <h1 class="text-2xl sm:text-3xl font-extrabold font-display leading-tight">
            Portal Rekapitulasi Pelanggaran Siswa
          </h1>
          <p class="text-sm text-blue-200 mt-2 font-medium">
            SMP NEGERI 1 SIDOMULYO
          </p>

          <div class="mt-8 space-y-4 text-xs sm:text-sm text-slate-200">
            <div class="flex items-start gap-3">
              <div class="p-2 rounded-xl bg-blue-500/20 text-blue-300 shrink-0 mt-0.5">
                <i data-lucide="user-check" class="w-4 h-4"></i>
              </div>
              <div>
                <p class="font-bold text-white">Akses Guru &amp; Wali Kelas</p>
                <p class="text-xs text-slate-300 mt-0.5">Mencatat pelanggaran harian siswa, memantau poin kelas, dan mengunduh rekap laporan.</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="p-2 rounded-xl bg-amber-500/20 text-amber-300 shrink-0 mt-0.5">
                <i data-lucide="shield" class="w-4 h-4"></i>
              </div>
              <div>
                <p class="font-bold text-white">Akses Admin (BK / Kesiswaan)</p>
                <p class="text-xs text-slate-300 mt-0.5">Kontrol penuh data induk siswa, impor Excel, kelola akun guru, dan tindak lanjut skor &gt; 200 poin.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="relative z-10 mt-8 pt-5 border-t border-white/10 text-xs text-blue-200/80 flex items-center justify-between">
          <span>Tahun Pelajaran 2026</span>
          <span>944 Siswa Terdaftar</span>
        </div>
      </div>

      <!-- Right Login Form Panel -->
      <div class="lg:col-span-7 p-7 sm:p-10 flex flex-col justify-center bg-white">
        <div class="max-w-md w-full mx-auto space-y-6">
          <div>
            <h2 class="text-2xl font-extrabold text-slate-900 font-display">Masuk ke Sistem</h2>
            <p class="text-xs sm:text-sm text-slate-500 mt-1">
              Pilih peran Anda dan masukkan username/NIP serta kata sandi untuk melanjutkan.
            </p>
          </div>

          <!-- Role Switcher Pills -->
          <div class="grid grid-cols-2 gap-2 p-1.5 bg-slate-100 rounded-2xl border border-slate-200">
            <button type="button" id="rolePillGuru" onclick="selectLoginRole('guru')"
              class="flex items-center justify-center gap-2 py-2.5 px-3 rounded-xl text-xs sm:text-sm font-bold transition-all bg-white text-blue-700 shadow-xs cursor-pointer">
              <i data-lucide="graduation-cap" class="w-4 h-4"></i>
              <span>Login Guru</span>
            </button>
            <button type="button" id="rolePillAdmin" onclick="selectLoginRole('admin')"
              class="flex items-center justify-center gap-2 py-2.5 px-3 rounded-xl text-xs sm:text-sm font-bold transition-all text-slate-600 hover:text-slate-900 cursor-pointer">
              <i data-lucide="shield-check" class="w-4 h-4"></i>
              <span>Login Admin</span>
            </button>
          </div>

          <form id="loginForm" class="space-y-4" novalidate>
            <input type="hidden" id="loginSelectedRole" value="guru" />

            <div>
              <label for="loginUsername" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                Username / NIP
              </label>
              <div class="relative">
                <i data-lucide="user" class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
                <input type="text" id="loginUsername" required autocomplete="username" placeholder="Masukkan username atau NIP (contoh: guru001 / admin)"
                  class="w-full pl-10 pr-4 py-3 rounded-xl border border-slate-300 bg-slate-50 focus:bg-white text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500 transition" />
              </div>
            </div>

            <div>
              <label for="loginPassword" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                Kata Sandi (Password)
              </label>
              <div class="relative">
                <i data-lucide="lock" class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
                <input type="password" id="loginPassword" required autocomplete="current-password" placeholder="Masukkan kata sandi..."
                  class="w-full pl-10 pr-11 py-3 rounded-xl border border-slate-300 bg-slate-50 focus:bg-white text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500 transition" />
                <button type="button" onclick="toggleLoginPassword()" title="Tampilkan/Sembunyikan Sandi"
                  class="absolute right-3 top-1/2 -translate-y-1/2 p-1 text-slate-400 hover:text-slate-600 cursor-pointer">
                  <i id="loginEyeIcon" data-lucide="eye" class="w-4 h-4"></i>
                </button>
              </div>
            </div>

            <div id="loginErrorBox" class="hidden p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-xs font-semibold flex items-center gap-2">
              <i data-lucide="alert-circle" class="w-4 h-4 shrink-0"></i>
              <span id="loginErrorText">Username atau kata sandi salah.</span>
            </div>

            <button type="submit"
              class="w-full py-3 px-5 rounded-xl bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white font-bold text-sm shadow-lg shadow-blue-600/25 flex items-center justify-center gap-2 transition cursor-pointer">
              <i data-lucide="log-in" class="w-4 h-4"></i>
              <span id="loginSubmitLabel">Masuk sebagai Guru</span>
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- ==================== MAIN APPLICATION SHELL (HIDDEN UNTIL LOGGED IN) ==================== -->
  <div id="appShell" class="hidden min-h-screen flex flex-col">

    <!-- ==================== TOP HEADER ==================== -->
    <header class="bg-gradient-to-r from-slate-900 via-blue-950 to-slate-900 text-white shadow-lg sticky top-0 z-30">
      <div id="headerInnerContainer" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 transition-all">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-3.5">
          <!-- Brand & School Title -->
          <div class="flex items-center justify-between gap-3">
            <div class="flex items-center gap-3">
              <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-2xl bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center shadow-md shadow-blue-950/50 shrink-0 border border-blue-400/30">
                <i data-lucide="shield-alert" class="w-6 h-6 sm:w-7 sm:h-7 text-white"></i>
              </div>
              <div>
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="text-lg sm:text-2xl font-extrabold tracking-tight font-display text-white">POINT</span>
                  <span class="text-[11px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded-full bg-blue-500/20 text-blue-200 border border-blue-400/30">
                    Tata Tertib 2026
                  </span>
                </div>
                <p class="text-xs sm:text-sm text-slate-300 font-medium mt-0.5">
                  Rekap Pelanggaran • <strong class="text-white">SMPN 1 SIDOMULYO</strong>
                </p>
              </div>
            </div>

            <!-- View Mode Switcher (Desktop / Mobile) -->
            <div class="inline-flex items-center p-1 rounded-xl bg-white/10 border border-white/15 backdrop-blur-xs shrink-0" role="group" aria-label="Pilih Mode Tampilan">
              <button type="button" id="btnModeDesktop" onclick="setViewMode('desktop')" title="Tampilan Desktop (Layar Lebar)"
                class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer bg-blue-600 text-white shadow-xs">
                <i data-lucide="monitor" class="w-3.5 h-3.5"></i>
                <span class="hidden sm:inline">Desktop</span>
              </button>
              <button type="button" id="btnModeMobile" onclick="setViewMode('mobile')" title="Tampilan Mobile (Ramah Sentuh & Ringkas)"
                class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer text-slate-300 hover:text-white">
                <i data-lucide="smartphone" class="w-3.5 h-3.5"></i>
                <span class="hidden sm:inline">Mobile</span>
              </button>
            </div>
          </div>

          <!-- Quick KPI Summary Badges + Active User Session -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5">
            <div id="headerKpiGrid" class="grid grid-cols-3 gap-2 text-left">
              <div class="bg-white/10 backdrop-blur-sm border border-white/10 rounded-xl px-3 py-1.5">
                <p class="text-[10px] text-slate-300 uppercase tracking-wider">Total Siswa</p>
                <p id="headerTotalStudents" class="text-sm sm:text-base font-bold text-white leading-tight mt-0.5">0</p>
              </div>
              <div class="bg-white/10 backdrop-blur-sm border border-white/10 rounded-xl px-3 py-1.5">
                <p class="text-[10px] text-slate-300 uppercase tracking-wider">Total Kasus</p>
                <p id="headerTotalCases" class="text-sm sm:text-base font-bold text-amber-300 leading-tight mt-0.5">0</p>
              </div>
              <div class="bg-rose-500/20 backdrop-blur-sm border border-rose-400/30 rounded-xl px-3 py-1.5">
                <p class="text-[10px] text-rose-200 uppercase tracking-wider">Skor &gt; 200</p>
                <p id="headerWarningStudents" class="text-sm sm:text-base font-bold text-rose-300 leading-tight mt-0.5">0 Siswa</p>
              </div>
            </div>

            <!-- Active User Profile & Logout -->
            <div class="flex items-center justify-between sm:justify-end gap-3 bg-white/10 border border-white/15 rounded-xl px-3.5 py-2">
              <div class="text-left sm:text-right">
                <div class="flex items-center sm:justify-end gap-1.5">
                  <span id="activeUserRoleBadge" class="text-[10px] font-extrabold uppercase px-2 py-0.5 rounded-md bg-emerald-500 text-white">GURU</span>
                  <p id="activeUserName" class="text-xs sm:text-sm font-bold text-white truncate max-w-[150px]">Guru Piket</p>
                </div>
                <p id="activeUserSubtext" class="text-[11px] text-slate-300">Wali Kelas / Guru</p>
              </div>
              <button type="button" onclick="logoutUser()" title="Keluar dari akun"
                class="p-2 rounded-lg bg-rose-500/20 hover:bg-rose-600 text-rose-200 hover:text-white border border-rose-400/30 transition cursor-pointer shrink-0">
                <i data-lucide="log-out" class="w-4 h-4"></i>
              </button>
            </div>
          </div>
        </div>

        <!-- Desktop Navigation Tabs -->
        <nav id="desktopTopNav" class="flex items-center gap-1.5 sm:gap-2 mt-4 pt-3 border-t border-white/10 overflow-x-auto custom-scroll pb-1" aria-label="Menu Utama">
          <button onclick="switchTab('entry')" id="tab-entry" class="nav-btn flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold transition-all whitespace-nowrap bg-blue-600 text-white shadow-sm cursor-pointer">
            <i data-lucide="file-plus-2" class="w-4 h-4"></i>
            <span>Form Entry Pelanggaran</span>
          </button>
          <button onclick="switchTab('recap')" id="tab-recap" class="nav-btn flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold transition-all whitespace-nowrap text-slate-300 hover:text-white hover:bg-white/10 cursor-pointer">
            <i data-lucide="bar-chart-3" class="w-4 h-4"></i>
            <span>Rekap &amp; Grafik</span>
            <span id="navWarningBadge" class="hidden ml-1 px-2 py-0.5 text-xs font-bold rounded-full bg-rose-600 text-white">0</span>
          </button>
          <button onclick="switchTab('students')" id="tab-students" class="nav-btn flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold transition-all whitespace-nowrap text-slate-300 hover:text-white hover:bg-white/10 cursor-pointer">
            <i data-lucide="users" class="w-4 h-4"></i>
            <span id="tabStudentsLabel">Data Siswa &amp; Impor</span>
          </button>
          <button onclick="switchTab('rules')" id="tab-rules" class="nav-btn flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold transition-all whitespace-nowrap text-slate-300 hover:text-white hover:bg-white/10 cursor-pointer">
            <i data-lucide="book-open-check" class="w-4 h-4"></i>
            <span>Daftar Poin Tata Tertib</span>
          </button>
          <button onclick="switchTab('admin')" id="tab-admin" class="nav-btn hidden flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold transition-all whitespace-nowrap text-amber-200 hover:text-white hover:bg-amber-500/20 border border-amber-400/30 cursor-pointer">
            <i data-lucide="shield-check" class="w-4 h-4 text-amber-300"></i>
            <span>Dashboard Admin &amp; Akun</span>
          </button>
        </nav>
      </div>
    </header>

    <!-- ==================== GLOBAL WARNING BANNER (> 200 POINTS) ==================== -->
    <div id="globalWarningBanner" class="hidden bg-rose-600 text-white border-b border-rose-700">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex items-start sm:items-center gap-3">
          <div class="p-2 bg-white/20 rounded-xl shrink-0">
            <i data-lucide="alert-triangle" class="w-5 h-5 text-white"></i>
          </div>
          <div>
            <p class="font-bold text-sm sm:text-base">
              PERINGATAN BATAS POIN PELANGGARAN (&gt; 200 POIN)!
            </p>
            <p id="globalWarningText" class="text-xs sm:text-sm text-rose-100">
              Terdapat siswa yang telah melampaui akumulasi skor 200 poin dan memerlukan tindak lanjut pembinaan / panggilan orang tua.
            </p>
          </div>
        </div>
        <button onclick="switchTab('recap')" class="self-start sm:self-center px-4 py-2 bg-white text-rose-700 hover:bg-rose-50 font-bold text-xs sm:text-sm rounded-xl shadow-sm transition whitespace-nowrap cursor-pointer">
          Lihat Daftar Siswa &rarr;
        </button>
      </div>
    </div>

    <!-- ==================== MAIN CONTENT CONTAINER ==================== -->
    <main id="mainContentContainer" class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6 transition-all">

      <!-- ===================================================================== -->
      <!-- SECTION 1: FORM ENTRY PELANGGARAN                                     -->
      <!-- ===================================================================== -->
      <section id="view-entry" class="tab-view grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- Left Column: Entry Form -->
        <div id="entryFormCard" class="lg:col-span-7 bg-white rounded-2xl shadow-sm border border-slate-200/80 overflow-hidden">
          <div class="px-5 sm:px-6 py-4 sm:py-5 border-b border-slate-100 bg-slate-50/70 flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
            <div>
              <h2 class="text-base sm:text-lg font-bold text-slate-900 flex items-center gap-2">
                <i data-lucide="clipboard-edit" class="w-5 h-5 text-blue-600"></i>
                Input Catatan Pelanggaran Siswa
              </h2>
              <p class="text-xs sm:text-sm text-slate-500 mt-0.5">
                Pilih kelas dan siswa, lalu tentukan jenis pelanggaran untuk menghitung poin secara otomatis.
              </p>
            </div>
            <!-- Quick View Mode Indicator Pill inside Entry Card -->
            <button type="button" onclick="toggleViewModeQuick()"
              class="self-start sm:self-center inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-blue-50 hover:bg-blue-100 text-blue-700 border border-blue-200 text-xs font-bold transition cursor-pointer shrink-0">
              <i id="entryModeQuickIcon" data-lucide="smartphone" class="w-3.5 h-3.5"></i>
              <span id="entryModeQuickLabel">Beralih ke Mode Mobile</span>
            </button>
          </div>

          <!-- Quick Grade Filter Bar -->
          <div class="px-5 sm:px-6 pt-4 pb-1 flex items-center gap-1.5 overflow-x-auto custom-scroll">
            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 mr-1 shrink-0">Filter Jenjang:</span>
            <button type="button" onclick="filterGradeQuick('')" id="grade-pill-all"
              class="grade-pill px-3 py-1.5 rounded-xl text-xs font-bold bg-blue-600 text-white shadow-xs transition cursor-pointer shrink-0">
              Semua
            </button>
            <button type="button" onclick="filterGradeQuick('7')" id="grade-pill-7"
              class="grade-pill px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-700 transition cursor-pointer shrink-0">
              Kelas 7 (7A–7I)
            </button>
            <button type="button" onclick="filterGradeQuick('8')" id="grade-pill-8"
              class="grade-pill px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-700 transition cursor-pointer shrink-0">
              Kelas 8 (8A–8I)
            </button>
            <button type="button" onclick="filterGradeQuick('9')" id="grade-pill-9"
              class="grade-pill px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-700 transition cursor-pointer shrink-0">
              Kelas 9 (9A–9I)
            </button>
          </div>

          <form id="violationForm" class="p-5 sm:p-6 space-y-5" novalidate>
            <!-- Row 1: Tanggal & Hari -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="inputTanggal" class="block text-sm font-semibold text-slate-700 mb-1.5">
                  Tanggal Pelanggaran <span class="text-rose-600">*</span>
                </label>
