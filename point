    function getStudentTotalPoints(studentId) {
      return violationLogs
        .filter(log => log.studentId === studentId)
        .reduce((sum, item) => sum + Number(item.points || 0), 0);
    }

    function renderStudentDropdownList() {
      const dropdown = document.getElementById('studentDropdownList');
      const selectedClass = document.getElementById('inputKelas').value;
      const keyword = document.getElementById('studentSearchInput').value.trim().toLowerCase();

      const filtered = students.filter(s => {
        if (selectedGradePrefix && !s.kelas.startsWith(selectedGradePrefix)) return false;
        if (selectedClass && s.kelas !== selectedClass) return false;
        if (keyword) {
          const matchName = s.nama.toLowerCase().includes(keyword);
          const matchNis = (s.nis || '').toLowerCase().includes(keyword);
          const matchNisn = (s.nisn || '').toLowerCase().includes(keyword);
          const matchClass = s.kelas.toLowerCase().includes(keyword);
          return matchName || matchNis || matchNisn || matchClass;
        }
        return true;
      });

      if (filtered.length === 0) {
        dropdown.innerHTML = `
          <div class="p-4 text-center text-xs text-slate-500">
            Tidak ada siswa ditemukan untuk kriteria tersebut.
          </div>
        `;
        return;
      }

      const displaySlice = filtered.slice(0, 80);
      dropdown.innerHTML = displaySlice.map(s => {
        const pts = getStudentTotalPoints(s.id);
        const badgeColor = pts > 200
          ? 'bg-rose-100 text-rose-700 border-rose-200'
          : pts > 0
            ? 'bg-amber-100 text-amber-800 border-amber-200'
            : 'bg-slate-100 text-slate-600 border-slate-200';
        return `
          <button type="button" onclick="selectStudentForEntry('${s.id}')"
            class="w-full px-4 py-2.5 text-left hover:bg-blue-50 flex items-center justify-between gap-3 transition cursor-pointer">
            <div>
              <p class="text-xs sm:text-sm font-bold text-slate-800">${escapeHtml(s.nama)}</p>
              <p class="text-[11px] text-slate-500">Kelas <strong class="text-slate-700">${escapeHtml(s.kelas)}</strong> • NIS: ${escapeHtml(s.nis || '-')}</p>
            </div>
            <span class="px-2 py-0.5 rounded-lg text-[11px] font-bold border ${badgeColor} shrink-0">
              ${pts} Poin
            </span>
          </button>
        `;
      }).join('');

      if (filtered.length > 80) {
        dropdown.innerHTML += `
          <div class="px-4 py-2 bg-slate-50 text-[11px] text-slate-500 text-center">
            Menampilkan 80 dari ${filtered.length} siswa. Ketik nama untuk mempersempit pencarian.
          </div>
        `;
      }
    }

    function selectStudentForEntry(studentId) {
      const stu = students.find(s => s.id === studentId);
      if (!stu) return;

      document.getElementById('selectedStudentId').value = stu.id;
      document.getElementById('studentSearchInput').value = `${stu.nama} (${stu.kelas})`;
      document.getElementById('inputKelas').value = stu.kelas;
      document.getElementById('studentDropdownList').classList.add('hidden');
      document.getElementById('clearStudentSelectionBtn').classList.remove('hidden');

      const pts = getStudentTotalPoints(stu.id);
      document.getElementById('selStudentNameDisplay').textContent = stu.nama;
      document.getElementById('selStudentMetaDisplay').textContent = `Kelas: ${stu.kelas} | NIS: ${stu.nis || '-'} | NISN: ${stu.nisn || '-'}`;
      const ptsEl = document.getElementById('selStudentCurrentPoints');
      ptsEl.textContent = `${pts} Poin${pts > 200 ? ' (WARNING)' : ''}`;
      ptsEl.className = pts > 200 ? 'text-sm font-extrabold text-rose-600' : 'text-sm font-extrabold text-blue-900';

      document.getElementById('selectedStudentCard').classList.remove('hidden');
