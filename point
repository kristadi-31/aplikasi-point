            <td class="py-3 px-4 text-slate-800 font-medium">${escapeHtml(r.text)}</td>
            <td class="py-3 px-4 text-center">${catBadge}</td>
            <td class="py-3 px-4 text-right font-extrabold text-slate-900">${r.points} Poin</td>
          </tr>
        `;
      }).join('');
    }

    /**
     * 14. DASHBOARD ADMIN & MANAJEMEN AKUN PENGGUNA
     */
    function renderAdminDashboard() {
      if (!currentUser || currentUser.role !== 'admin') return;

      [7, 8, 9].forEach(grade => {
        const gradeLogs = violationLogs.filter(l => (l.studentClass || '').startsWith(String(grade)));
        const totalPts = gradeLogs.reduce((sum, l) => sum + Number(l.points || 0), 0);
        document.getElementById(`adminStatGrade${grade}`).textContent = `${totalPts.toLocaleString('id-ID')} Poin`;
        document.getElementById(`adminCasesGrade${grade}`).textContent = `${gradeLogs.length} kasus tercatat`;
      });

      const kw = document.getElementById('adminUserSearchInput').value.trim().toLowerCase();
      const filteredUsers = appUsers.filter(u =>
        !kw ||
        u.fullName.toLowerCase().includes(kw) ||
        u.username.toLowerCase().includes(kw) ||
        (u.nip || '').toLowerCase().includes(kw) ||
        (u.title || '').toLowerCase().includes(kw)
      );

      document.getElementById('adminUsersCountBadge').textContent = `${filteredUsers.length} Akun`;
      const tbody = document.getElementById('adminUsersTableBody');

      tbody.innerHTML = filteredUsers.map(u => {
        const isSelf = currentUser && currentUser.id === u.id;
        return `
          <tr class="hover:bg-slate-50 transition">
            <td class="py-3 px-4">
              <p class="font-bold text-slate-900 text-xs sm:text-sm">${escapeHtml(u.fullName)}</p>
              <p class="text-[11px] text-slate-500">NIP: ${escapeHtml(u.nip || '-')} • ${escapeHtml(u.title || '-')}</p>
            </td>
            <td class="py-3 px-4 font-mono text-xs font-bold text-blue-700">${escapeHtml(u.username)}</td>
            <td class="py-3 px-4 font-mono text-xs text-slate-600">${escapeHtml(u.password)}</td>
            <td class="py-3 px-4 text-center">
              <span class="px-2 py-0.5 rounded-md text-[10px] font-extrabold uppercase ${u.role === 'admin' ? 'bg-amber-100 text-amber-800' : 'bg-emerald-100 text-emerald-700'}">
                ${escapeHtml(u.role)}
              </span>
            </td>
            <td class="py-3 px-4 text-center">
              ${!isSelf ? `
                <button type="button" onclick="deleteUserAccount('${u.id}')" title="Hapus akun"
                  class="p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition cursor-pointer">
                  <i data-lucide="trash-2" class="w-4 h-4"></i>
                </button>
              ` : '<span class="text-[11px] font-semibold text-slate-400">Aktif</span>'}
            </td>
          </tr>
        `;
      }).join('');
    }

    function handleAddAccountSubmit(e) {
      e.preventDefault();
      if (!currentUser || currentUser.role !== 'admin') return;

      const fullName = document.getElementById('accFullName').value.trim();
      const role = document.getElementById('accRole').value;
      const title = document.getElementById('accTitle').value.trim();
      const nip = document.getElementById('accNip').value.trim() || '-';
      const username = document.getElementById('accUsername').value.trim();
      const password = document.getElementById('accPassword').value.trim();

      if (!fullName || !username || password.length < 5) {
        showToast('Pastikan nama, username, dan password (minimal 5 karakter) terisi.', 'error');
        return;
      }

      if (appUsers.some(u => u.username.toLowerCase() === username.toLowerCase())) {
        showToast(`Username "${username}" sudah digunakan.`, 'error');
        return;
      }

      appUsers.push({
        id: `usr-${Date.now()}`,
        username,
        nip,
        password,
        role,
        fullName,
        title
      });
      saveUsers();
      document.getElementById('addAccountForm').reset();
      renderAdminDashboard();
      refreshIcons();
      showToast(`Akun ${fullName} (${username}) berhasil dibuat.`, 'success');
    }

    function deleteUserAccount(userId) {
      if (!currentUser || currentUser.role !== 'admin') return;
      const target = appUsers.find(u => u.id === userId);
      if (!target || target.id === currentUser.id) return;

      openConfirmModal(
        'Hapus Akun Pengguna?',
        `Akun "${target.fullName}" (${target.username}) tidak akan dapat login lagi.`,
        () => {
          appUsers = appUsers.filter(u => u.id !== userId);
          saveUsers();
          renderAdminDashboard();
          refreshIcons();
          showToast('Akun pengguna berhasil dihapus.', 'info');
        }
      );
    }

    /**
     * 15. MODALS & TOAST NOTIFICATIONS
     */
    function openStudentDetailModal(studentId) {
      const stu = students.find(s => s.id === studentId);
      const stuLogs = violationLogs.filter(l => l.studentId === studentId);
      const totalPts = stuLogs.reduce((sum, l) => sum + Number(l.points || 0), 0);

      const name = stu ? stu.nama : (stuLogs[0] ? stuLogs[0].studentName : 'Siswa');
      const kelas = stu ? stu.kelas : (stuLogs[0] ? stuLogs[0].studentClass : '-');
      const nis = stu ? (stu.nis || '-') : '-';
      const nisn = stu ? (stu.nisn || '-') : '-';

      document.getElementById('modalStudentClassBadge').textContent = `KELAS ${kelas}`;
      document.getElementById('modalStudentName').textContent = name;
      document.getElementById('modalStudentMeta').textContent = `NIS: ${nis} | NISN: ${nisn}`;
      document.getElementById('modalStudentCases').textContent = `${stuLogs.length} Kasus`;
      document.getElementById('modalStudentPoints').textContent = `${totalPts} Poin`;

      const warnBanner = document.getElementById('modalStudentWarningBanner');
      if (totalPts > 200) {
        warnBanner.classList.remove('hidden');
      } else {
        warnBanner.classList.add('hidden');
      }

      const listEl = document.getElementById('modalStudentLogsList');
      const isAdmin = currentUser && currentUser.role === 'admin';

      if (stuLogs.length === 0) {
        listEl.innerHTML = `<p class="text-xs text-slate-400 text-center py-6">Siswa ini belum memiliki catatan pelanggaran.</p>`;
      } else {
        listEl.innerHTML = stuLogs.map(l => `
          <div class="p-3.5 rounded-xl border border-slate-200 bg-slate-50 flex items-start justify-between gap-3">
            <div>
              <p class="text-xs font-bold text-slate-800">${escapeHtml(l.violationText)}</p>
              <p class="text-[11px] text-slate-500 mt-1">${escapeHtml(l.hari)}, ${escapeHtml(l.tanggal)} • Dicatat oleh ${escapeHtml(l.recordedBy || '-')}</p>
              ${l.notes && l.notes !== '-' ? `<p class="text-[11px] text-slate-600 mt-0.5">Keterangan: ${escapeHtml(l.notes)}</p>` : ''}
            </div>
            <div class="flex items-center gap-1.5 shrink-0">
              <span class="px-2.5 py-1 rounded-lg bg-rose-100 text-rose-700 font-extrabold text-xs">+${l.points}</span>
              ${isAdmin ? `
                <button type="button" onclick="deleteViolationLog('${l.id}')" class="p-1 text-slate-400 hover:text-rose-600 cursor-pointer">
                  <i data-lucide="trash-2" class="w-4 h-4"></i>
                </button>
              ` : ''}
            </div>
          </div>
        `).join('');
      }

      document.getElementById('studentDetailModal').classList.remove('hidden');
      refreshIcons();
    }

    function closeStudentDetailModal() {
      document.getElementById('studentDetailModal').classList.add('hidden');
    }

    function openConfirmModal(title, message, onConfirm) {
      document.getElementById('confirmModalTitle').textContent = title;
      document.getElementById('confirmModalMessage').textContent = message;
      pendingConfirmAction = onConfirm;
      document.getElementById('confirmModal').classList.remove('hidden');
      refreshIcons();
    }

    function closeConfirmModal() {
      pendingConfirmAction = null;
      document.getElementById('confirmModal').classList.add('hidden');
    }

    function showToast(message, type = 'info') {
      const container = document.getElementById('toastContainer');
      const toast = document.createElement('div');

      const styles = {
        success: 'bg-emerald-600 text-white border-emerald-700',
        error: 'bg-rose-600 text-white border-rose-700',
        warning: 'bg-amber-500 text-slate-950 border-amber-600 font-bold',
        info: 'bg-slate-900 text-white border-slate-700'
      };

      toast.className = `pointer-events-auto px-4 py-3 rounded-2xl shadow-xl border text-xs sm:text-sm font-semibold flex items-center justify-between gap-3 transition-all ${styles[type] || styles.info}`;
      toast.innerHTML = `<span>${escapeHtml(message)}</span>`;

      container.appendChild(toast);
      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateY(8px)';
        setTimeout(() => toast.remove(), 250);
      }, 3600);
    }

    function refreshAllViews() {
      const summaries = buildStudentSummaries();
      updateHeaderAndGlobalWarnings(summaries);
      renderRecentLogs();
      renderRecapAndChart();
      renderStudentDirectory();
      renderRulesTable();
      if (currentUser && currentUser.role === 'admin') {
        renderAdminDashboard();
      }
      refreshIcons();
    }

    /**
     * 16. BOOTSTRAP & EVENT LISTENERS ON LOAD
     */
    window.addEventListener('DOMContentLoaded', () => {
      loadPersistedState();
      populateClassDropdowns();
      populateViolationDropdown('');
      initDateAndDay();

      // Login form submit
      document.getElementById('loginForm').addEventListener('submit', handleLoginSubmit);

      // Entry form events
      document.getElementById('inputTanggal').addEventListener('change', syncDayFromDate);
      document.getElementById('inputKelas').addEventListener('change', () => {
        clearSelectedStudent();
        renderStudentDropdownList();
      });

      const studentSearchInput = document.getElementById('studentSearchInput');
      studentSearchInput.addEventListener('focus', () => {
        renderStudentDropdownList();
        document.getElementById('studentDropdownList').classList.remove('hidden');
      });
      studentSearchInput.addEventListener('input', () => {
        document.getElementById('selectedStudentId').value = '';
        document.getElementById('selectedStudentCard').classList.add('hidden');
        renderStudentDropdownList();
        document.getElementById('studentDropdownList').classList.remove('hidden');
      });

      document.getElementById('clearStudentSelectionBtn').addEventListener('click', () => {
        clearSelectedStudent();
        renderStudentDropdownList();
        studentSearchInput.focus();
      });

      // Close student dropdown when clicking outside
      document.addEventListener('click', (e) => {
        const wrapper = document.getElementById('studentPickerWrapper');
        const dropdown = document.getElementById('studentDropdownList');
        if (wrapper && dropdown && !wrapper.contains(e.target)) {
          dropdown.classList.add('hidden');
        }
      });

      document.getElementById('violationFilterInput').addEventListener('input', (e) => {
        populateViolationDropdown(e.target.value);
      });
      document.getElementById('inputViolation').addEventListener('change', updateAutoPointDisplay);
      document.getElementById('violationForm').addEventListener('submit', handleViolationSubmit);

      // Recap filter listeners
      document.getElementById('recapSearchInput').addEventListener('input', renderRecapAndChart);
      document.getElementById('recapClassFilter').addEventListener('change', renderRecapAndChart);
      document.getElementById('recapStatusFilter').addEventListener('change', renderRecapAndChart);

      // Student directory & import listeners
      document.getElementById('studentFileInput').addEventListener('change', handleStudentFileUpload);
      document.getElementById('addStudentForm').addEventListener('submit', handleAddStudentSubmit);
      document.getElementById('directorySearchInput').addEventListener('input', renderStudentDirectory);
      document.getElementById('directoryClassFilter').addEventListener('change', renderStudentDirectory);

      // Rules & Admin listeners
      document.getElementById('rulesSearchInput').addEventListener('input', renderRulesTable);
      document.getElementById('addAccountForm').addEventListener('submit', handleAddAccountSubmit);
      document.getElementById('adminUserSearchInput').addEventListener('input', renderAdminDashboard);

      // Confirm modal action button
      document.getElementById('confirmModalActionBtn').addEventListener('click', () => {
        if (typeof pendingConfirmAction === 'function') {
          pendingConfirmAction();
        }
        closeConfirmModal();
      });

      // Restore logged-in session if available
      if (currentUser) {
        completeLogin(currentUser);
      } else {
        setViewMode(currentViewMode);
        refreshIcons();
      }
    });
  </script>
</body>
</html>
